rules_version = '2';

// Storage-Regeln für die Bilder der Sam-Sparking-Website.
//
// WICHTIG: Diese Datei deckt nur den Pfad samsparking/media ab. Wird sie
// unverändert deployt, verlieren alle anderen Pfade im Bucket ihre Regeln.
// Den match-Block in die bestehenden Regeln des Projekts jupidu-36804
// einfügen (Firebase Console → Storage → Rules) und von dort speichern.
//
// Lesen ist offen: die Dateien stehen ohnehin öffentlich auf der Website.
// Schreiben nur angemeldet, nur Bilder und Videos, maximal 250 MB.
// Die Grenze muss zu MAX_UPLOAD_BYTES in public/js/config.js passen.

service firebase.storage {
  match /b/{bucket}/o {

    match /samsparking/media/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.resource.size < 250 * 1024 * 1024
                   && (request.resource.contentType.matches('image/.*')
                       || request.resource.contentType.matches('video/.*'));
      allow delete: if request.auth != null;
    }

  }
}
